# Local browser configuration only. Obtain these non-secret values from `npm run supabase:status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# The PandaScore API token is entered through /admin and never belongs in this file.
# The two identifiers are only needed by the trusted sync function and must be configured in
# `supabase/functions/.env` (ignored by git) for local development.
